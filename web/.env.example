# Copy to .env and fill in. Never commit .env.

# Postgres connection string from Supabase. Get one free from:
#   https://supabase.com → New project → Project Settings → Database
#   → "Connection string" → "Transaction pooler" (port 6543, IPv4-friendly,
#     better for Next.js Route Handlers / serverless)
# It looks like: postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API config — required by the Phase 2b PDF generation step
# (creates the legalpulse-pdfs bucket and uploads weekly PDFs).
# Find both at:
#   https://supabase.com/dashboard/project/<ref>/settings/api
#
# - NEXT_PUBLIC_SUPABASE_URL: the "Project URL" (https://<ref>.supabase.co)
# - SUPABASE_SERVICE_ROLE_KEY: the *service_role* key (NOT the anon key).
#     This is a sensitive secret — never commit. Used only in server-side
#     scripts that need to write to Storage / bypass RLS.
# - NEXT_PUBLIC_SUPABASE_ANON_KEY: only needed if/when the frontend talks
#     to Supabase APIs directly. Phase 1-2 don't use it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used in metadata, sitemaps, OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: No ANTHROPIC_API_KEY. Agents run as Claude Code subagents using the
# user's subscription auth. The weekly pipeline is triggered by a /schedule
# routine, not by a script that calls the Anthropic API.
