{
  "name": "legalpulse-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs migrate",
    "db:seed": "node --env-file=.env scripts/migrate.mjs seed",
    "db:reset": "node --env-file=.env scripts/migrate.mjs reset",
    "db:apply": "node --env-file=.env scripts/migrate.mjs apply",
    "pipeline:persist": "node --env-file=.env scripts/persist.mjs",
    "pipeline:pdf": "tsx --env-file=.env scripts/pdf.tsx"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.1.6",
    "@supabase/supabase-js": "2.47.10",
    "next": "15.1.6",
    "postgres": "3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "20.17.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
